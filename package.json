{
  "name": "flaksefeber",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Flaksefeber: spill der serveren verifiserer fremgangen",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "TRUST_PROXY=${TRUST_PROXY:-1} next start -H 127.0.0.1 -p ${PORT:-49000}",
    "test": "tsx test/logic.test.ts && tsx test/api.test.ts && tsx test/admin.test.ts && tsx test/legacy.test.ts && tsx test/client.smoke.ts",
    "admin": "tsx scripts/admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  }
}
